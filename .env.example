# ====================================
# Claude Phone — Fork Configuration
# ====================================
# Provider-agnostic, open-source, free to operate.
# Copy this to .env, customize, then run:
#   docker compose -f docker-compose.full.yml up -d

# ====================================
# Network Configuration
# ====================================

EXTERNAL_IP=10.0.0.100

# ====================================
# AI Backend (choose one)
# ====================================
#   ollama     → Local LLM (free, default, runs in Docker)
#   claude     → Claude Code CLI (needs subscription)
#   openai     → OpenAI API (set OPENAI_API_KEY)
#   openrouter → OpenRouter API (set OPENROUTER_API_KEY)
#   custom     → Any OpenAI-compatible API
#
AI_BACKEND=ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
CLAUDE_API_URL=http://127.0.0.1:3333

# ====================================
# 3CX SBC (optional, env-var config)
# ====================================

SBC_MODE=auto
SBC_FQDN=your-3cx.3cx.us
SBC_AUTH_ID=your-auth-id
SBC_PASSWORD=your-password
SBC_NAME=docker-sbc

# ====================================
# Drachtio
# ====================================

DRACHTIO_SECRET=cymru
DRACHTIO_SIP_PORT=5070

# ====================================
# FreeSWITCH
# ====================================

FREESWITCH_SECRET=JambonzR0ck$

# ====================================
# 3CX / SIP
# ====================================

SIP_DOMAIN=your-3cx-server.3cx.us
SIP_REGISTRAR=10.0.0.50
SIP_EXTENSION=9000
SIP_AUTH_ID=your-auth-id
SIP_PASSWORD=your-password
DEFAULT_CALLER_ID=+15551234567

# ====================================
# STT
# ====================================

OPENROUTER_API_KEY=your-openrouter-api-key

# ====================================
# TTS
# ====================================

TTS_PROVIDER=kokoro
KOKORO_TTS_URL=http://kokoro-tts:8880
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ====================================
# Application
# ====================================

HTTP_PORT=3000
WS_PORT=3001
MAX_CONVERSATION_TURNS=10
OUTBOUND_RING_TIMEOUT=30

# DEBUG=voice-app:*
