# ============================================================================
# 3CX SBC Docker Image
# ============================================================================
#
# Packages the 3CX Session Border Controller into a container.
# Uses host networking for SIP/RTP.
#
# Configuration via environment variables:
#   SBC_FQDN=your-3cx.3cx.us
#   SBC_AUTH_ID=your-auth-id
#   SBC_PASSWORD=your-password
#   SBC_NAME=my-sbc            Optional: name for this SBC
#   SBC_LAN_IP=auto            Optional: override LAN IP detection
#
# Or mount a .prov provisioning file (generated by 3CX Management Console)
# at /etc/3cxsbc/3cxsbc.prov and set SBC_MODE=prov.
#
# ============================================================================

FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive \
    SBC_MODE=auto \
    SBC_FQDN="" \
    SBC_AUTH_ID="" \
    SBC_PASSWORD="" \
    SBC_NAME="" \
    SBC_LAN_IP="auto"

# Install runtime dependencies and 3CX repo
RUN apt-get update && apt-get install -y \
    ca-certificates \
    wget \
    gnupg \
    systemd \
    libc6 \
    --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Add 3CX GPG key and repository
RUN wget -qO- https://downloads-global.3cx.com/downloads/3cx-sbc/3cx-sbc.key | gpg --dearmor -o /usr/share/keyrings/3cxsbc-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/3cxsbc-archive-keyring.gpg] https://downloads-global.3cx.com/downloads/3cx-sbc/debian bookworm main" > /etc/apt/sources.list.d/3cxsbc.list

# Install the 3CX SBC package
RUN apt-get update \
    && apt-get install -y 3cxsbc --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    # Remove systemd service — we run the binary directly
    && rm -f /lib/systemd/system/3cxsbc.service \
    # Create config directory
    && mkdir -p /etc/3cxsbc

# Copy entrypoint
COPY docker/sbc/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# SBC needs host networking for SIP and RTP
# Ports: 5060 UDP/TCP (SIP), 20000-20099 UDP (RTP)
STOPSIGNAL SIGTERM

ENTRYPOINT ["/entrypoint.sh"]
